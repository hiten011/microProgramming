" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#16124F;exitX=0;exitY=0.682;exitDx=0;exitDy=0;entryX=1;entryY=0.682;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l_up1" value="|roll| &amp;gt; 50°" style="text;fillColor=none;strokeColor=none;html=1;fontSize=16;align=center;fontColor=#16124F;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="815" y="103" width="210" height="28" as="geometry"/></mxCell><mxCell id="l_dn1" value="|roll| ≤ 45°" style="text;fillColor=none;strokeColor=none;html=1;fontSize=16;align=center;fontColor=#16124F;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="815" y="179" width="210" height="28" as="geometry"/></mxCell><mxCell id="note" value="Start in FREE. Going up a zone and coming back down use different numbers (a 5° gap, the deadband), so a noisy reading near a limit cannot make the state flicker." style="text;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=top;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="235" width="1250" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pitch" name="Pitch FSM – pitch servo (PB5)"><mxGraphModel dx="1200" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1330" pageHeight="300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Pitch FSM – pitch servo (PB5)" style="text;fillColor=none;strokeColor=none;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;fontColor=#16124F;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="36" as="geometry"/></mxCell><mxCell id="sub" value="pitch = angle from tilting forward/back, in degrees. |pitch| means the size of the angle, ignoring direction." style="text;fillColor=none;strokeColor=none;html=1;fontSize=15;align