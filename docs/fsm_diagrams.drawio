<mxfile host="app.diagrams.net" version="24.0.0" type="device"><diagram id="roll" name="Roll FSM – roll servo (PB4)"><mxGraphModel dx="1200" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1330" pageHeight="300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Roll FSM – roll servo (PB4)" style="text;fillColor=none;strokeColor=none;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;fontColor=#16124F;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="36" as="geometry"/></mxCell><mxCell id="sub" value="roll = angle from tilting left/right, in degrees. |roll| means the size of the angle, ignoring direction." style="text;fillColor=none;strokeColor=none;html=1;fontSize=15;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1200" height="28" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;shape=ellipse;perimeter=ellipsePerimeter;html=1;fillColor=#16124F;strokeColor=#16124F;" vertex="1" parent="1"><mxGeometry x="40" y="143" width="24" height="24" as="geometry"/></mxCell><mxCell id="b0" value="&lt;b&gt;FREE&lt;/b&gt;&lt;br&gt;no force&lt;br&gt;servo = 90° (neutral)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=16;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="110" y="100" width="240" height="110" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;COMPLIANT&lt;/b&gt;&lt;br&gt;gentle push back&lt;br&gt;servo = 90° + roll" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=16;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="570" y="100" width="240" height="110" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;CLAMPED&lt;/b&gt;&lt;br&gt