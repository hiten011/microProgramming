<mxfile host="app.diagrams.net" version="24.0.0" type="device"><diagram id="axis" name="Axis FSM – used for both roll (PB4) and pitch (PB5)"><mxGraphModel dx="1200" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1330" pageHeight="300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Axis FSM – used for both roll (PB4) and pitch (PB5)" style="text;fillColor=none;strokeColor=none;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;fontColor=#16124F;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="36" as="geometry"/></mxCell><mxCell id="sub" value="angle = the roll angle (roll servo) or the pitch angle (pitch servo), in degrees. |angle| means the size of the angle, ignoring direction." style="text;fillColor=none;strokeColor=none;html=1;fontSize=15;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1200" height="28" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;shape=ellipse;perimeter=ellipsePerimeter;html=1;fillColor=#16124F;strokeColor=#16124F;" vertex="1" parent="1"><mxGeometry x="40" y="143" width="24" height="24" as="geometry"/></mxCell><mxCell id="b0" value="&lt;b&gt;FREE&lt;/b&gt;&lt;br&gt;no force&lt;br&gt;servo = 90° (neutral)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=16;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="110" y="100" width="240" height="110" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;COMPLIANT&lt;/b&gt;&lt;br&gt;gentle push back&lt;br&gt;servo = 90° + angle" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=16;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="570" y="100" width="240" height="110" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;CLAMPED&lt;/b&gt;&lt;br&gt;hard wall&lt;br&gt;servo locked at 90° ± 50°" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=16;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="100" width="240" height="110" as="geometry"/></mxCell><mxCell id="e_start" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#16124F;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="b0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_up0" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#16124F;exitX=1;exitY=0.318;exitDx=0;exitDy=0;entryX=0;entryY=0.318;entryDx=0;entryDy=0;" edge="1" parent="1" source="b0" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_dn0" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#16124F;exitX=0;exitY=0.682;exitDx=0;exitDy=0;entryX=1;entryY=0.682;entryDx=0;entryDy=0;" edge="1" parent="1" source="b1" target="b0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l_up0" value="|angle| ≥ 30°" style="text;fillColor=none;strokeColor=none;html=1;fontSize=16;align=center;fontColor=#16124F;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="355" y="103" width="210" height="28" as="geometry"/></mxCell><mxCell id="l_dn0" value="|angle| &amp;lt; 25°" style="text;fillColor=none;strokeColor=none;html=1;fontSize=16;align=center;fontColor=#16124F;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="355" y="179" width="210" height="28" as="geometry"/></mxCell><mxCell id="e_up1" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#16124F;exitX=1;exitY=0.318;exitDx=0;exitDy=0;entryX=0;entryY=0.318;entryDx=0;entryDy=0;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_dn1" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#16124F;exitX=0;exitY=0.682;exitDx=0;exitDy=0;entryX=1;entryY=0.682;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l_up1" value="|angle| &amp;gt; 50°" style="text;fillColor=none;strokeColor=none;html=1;fontSize=16;align=center;fontColor=#16124F;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="815" y="103" width="210" height="28" as="geometry"/></mxCell><mxCell id="l_dn1" value="|angle| ≤ 45°" style="text;fillColor=none;strokeColor=none;html=1;fontSize=16;align=center;fontColor=#16124F;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="815" y="179" width="210" height="28" as="geometry"/></mxCell><mxCell id="note" value="Start in FREE. The same FSM runs once for roll and once for pitch, each keeping its own state. Going up a zone and coming back down use different numbers (a 5° gap, the deadband), so a noisy reading near a limit cannot make the state flicker." style="text;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=top;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="235" width="1250" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="tilt" name="Tilt FSM – tilt servo (PB0)"><mxGraphModel dx="1200" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1330" pageHeight="300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Tilt FSM – tilt servo (PB0)" style="text;fillColor=none;strokeColor=none;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;fontColor=#16124F;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="36" as="geometry"/></mxCell><mxCell id="sub" value="tilt α = √(roll² + pitch²), in degrees. It is never negative." style="text;fillColor=none;strokeColor=none;html=1;fontSize=15;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1200" height="28" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;shape=ellipse;perimeter=ellipsePerimeter;html=1;fillColor=#16124F;strokeColor=#16124F;" vertex="1" parent="1"><mxGeometry x="40" y="143" width="24" height="24" as="geometry"/></mxCell><mxCell id="b0" value="&lt;b&gt;FREE&lt;/b&gt;&lt;br&gt;no force&lt;br&gt;tilt servo = 0°" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=16;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="110" y="100" width="240" height="110" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;COMPLIANT&lt;/b&gt;&lt;br&gt;early warning&lt;br&gt;tilt servo = 2 × α" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=16;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="570" y="100" width="240" height="110" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;CLAMPED&lt;/b&gt;&lt;br&gt;hard wall&lt;br&gt;tilt servo = 140°" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=16;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="100" width="240" height="110" as="geometry"/></mxCell><mxCell id="e_start" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#16124F;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="b0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_up0" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#16124F;exitX=1;exitY=0.318;exitDx=0;exitDy=0;entryX=0;entryY=0.318;entryDx=0;entryDy=0;" edge="1" parent="1" source="b0" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_dn0" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#16124F;exitX=0;exitY=0.682;exitDx=0;exitDy=0;entryX=1;entryY=0.682;entryDx=0;entryDy=0;" edge="1" parent="1" source="b1" target="b0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l_up0" value="α &amp;gt; 20°" style="text;fillColor=none;strokeColor=none;html=1;fontSize=16;align=center;fontColor=#16124F;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="355" y="103" width="210" height="28" as="geometry"/></mxCell><mxCell id="l_dn0" value="α &amp;lt; 15°" style="text;fillColor=none;strokeColor=none;html=1;fontSize=16;align=center;fontColor=#16124F;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="355" y="179" width="210" height="28" as="geometry"/></mxCell><mxCell id="e_up1" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#16124F;exitX=1;exitY=0.318;exitDx=0;exitDy=0;entryX=0;entryY=0.318;entryDx=0;entryDy=0;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_dn1" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#16124F;exitX=0;exitY=0.682;exitDx=0;exitDy=0;entryX=1;entryY=0.682;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l_up1" value="α ≥ 70°" style="text;fillColor=none;strokeColor=none;html=1;fontSize=16;align=center;fontColor=#16124F;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="815" y="103" width="210" height="28" as="geometry"/></mxCell><mxCell id="l_dn1" value="α ≤ 65°" style="text;fillColor=none;strokeColor=none;html=1;fontSize=16;align=center;fontColor=#16124F;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="815" y="179" width="210" height="28" as="geometry"/></mxCell><mxCell id="note" value="Start in FREE. Going up a zone and coming back down use different numbers (a 5° gap, the deadband), so a noisy reading near a limit cannot make the state flicker." style="text;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=top;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="235" width="1250" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="mode" name="Mode FSM – autopilot and manual LEDs (PA2, PB11)"><mxGraphModel dx="1200" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1330" pageHeight="300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Mode FSM – autopilot and manual LEDs (PA2, PB11)" style="text;fillColor=none;strokeColor=none;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;fontColor=#16124F;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="36" as="geometry"/></mxCell><mxCell id="sub" value="Looks at the roll and pitch zones (from the axis FSM) and the autopilot button (PA12)." style="text;fillColor=none;strokeColor=none;html=1;fontSize=15;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1200" height="28" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;shape=ellipse;perimeter=ellipsePerimeter;html=1;fillColor=#16124F;strokeColor=#16124F;" vertex="1" parent="1"><mxGeometry x="40" y="143" width="24" height="24" as="geometry"/></mxCell><mxCell id="b0" value="&lt;b&gt;MANUAL&lt;/b&gt;&lt;br&gt;Manual LED on (PB11)&lt;br&gt;Autopilot LED off" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=16;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="110" y="100" width="240" height="110" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;AUTOPILOT&lt;/b&gt;&lt;br&gt;Autopilot LED on (PA2)&lt;br&gt;Manual LED off" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=16;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="100" width="240" height="110" as="geometry"/></mxCell><mxCell id="e_start" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#16124F;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="b0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_up0" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#16124F;exitX=1;exitY=0.318;exitDx=0;exitDy=0;entryX=0;entryY=0.318;entryDx=0;entryDy=0;" edge="1" parent="1" source="b0" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_dn0" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#16124F;exitX=0;exitY=0.682;exitDx=0;exitDy=0;entryX=1;entryY=0.682;entryDx=0;entryDy=0;" edge="1" parent="1" source="b1" target="b0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l_up0" value="roll CLAMPED and pitch CLAMPED&lt;br&gt;OR button pressed" style="text;fillColor=none;strokeColor=none;html=1;fontSize=16;align=center;fontColor=#16124F;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="355" y="75" width="670" height="56" as="geometry"/></mxCell><mxCell id="l_dn0" value="button pressed AND&lt;br&gt;roll FREE and pitch FREE" style="text;fillColor=none;strokeColor=none;html=1;fontSize=16;align=center;fontColor=#16124F;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="355" y="179" width="670" height="56" as="geometry"/></mxCell><mxCell id="note" value="Start in MANUAL (the stick starts level, in the free zone). The brief does not say which mode to start in. The button counts once per press, not every 20 ms while it is held." style="text;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=top;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="235" width="1250" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>