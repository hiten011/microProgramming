<mxfile host="app.diagrams.net">
  <diagram name="Sorting System Flowchart v4 (from actual code)" id="sortingFlow4">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;" value="System Power-Up" vertex="1">
          <mxGeometry height="50" width="260" x="1330" y="20" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;align=left;verticalAlign=top;spacing=8;" value="&lt;div align=&quot;center&quot;&gt;&lt;b&gt;init()&lt;/b&gt;&lt;/div&gt;1. Clock_Enable(GPIOA_BUS); Clock_Enable(GPIOB_BUS); Clock_Enable(GPIOC_BUS); Clock_Enable(TIM3_BUS);&lt;br&gt;2. GPIO_InitPinsSameMode(GPIOA, {2,10}, INPUT, PULL_DOWN); GPIO_InitPin(GPIOB, 5, INPUT, PULL_DOWN); &lt;i&gt;// New Item, Step Gate, E-Stop&lt;/i&gt;&lt;br&gt;3. GPIO_InitPinsSameMode(GPIOA, {9,0,1,4,3,11,8}, OUTPUT, PULL_DOWN); &lt;i&gt;// Fault LED + Real RGB + Sensed RGB&lt;/i&gt;&lt;br&gt;4. GPIO_InitPin(GPIOB,0,ALT,NONE); GPIO_InitPin(GPIOC,7,ALT,NONE); &lt;i&gt;// servo pins → alt-function mode&lt;/i&gt;&lt;br&gt;5. GPIO_ConnectPeripheral(GPIOB,0,1); GPIO_ConnectPeripheral(GPIOC,7,1); &lt;i&gt;// AF1 = TIM3&lt;/i&gt;&lt;br&gt;6. Timer_Init(TIM3, TIM3_IRQn, psc=47, arr=19999, ...); &lt;i&gt;// both gates share ONE timer, 50 Hz&lt;/i&gt;&lt;br&gt;7. PWM_Init(TIM3, CH2, PWM1, true); PWM_Init(TIM3, CH3, PWM1, true); &lt;i&gt;// CH2=Gate1(PC7), CH3=Gate2(PB0); starts counter&lt;/i&gt;&lt;br&gt;8. Gate1_SetWidth(GATE_ANGLE_NEUTRAL); Gate2_SetWidth(GATE_ANGLE_NEUTRAL); &lt;i&gt;// both = 1500&lt;/i&gt;&lt;br&gt;9. EXTI_Init(GPIOA,2,RISING,EXTI2_3_IRQn); EXTI_Init(GPIOA,10,RISING,EXTI4_15_IRQn); EXTI_Init(GPIOB,5,RISING,EXTI4_15_IRQn);&lt;br&gt;10. SysTick_Init();&lt;br&gt;&lt;font color=&quot;#0000ff&quot;&gt;typedef enum&lt;/font&gt; {STATE_IDLE, STATE_ITEM_NEW, STATE_STAGE1, STATE_STAGE2, STATE_FAULT} SystemState_t;&lt;br&gt;&lt;font color=&quot;#0000ff&quot;&gt;volatile&lt;/font&gt; SystemState_t current_state = STATE_IDLE; &lt;font color=&quot;#0000ff&quot;&gt;volatile bool&lt;/font&gt; isStateChange = false;" vertex="1">
          <mxGeometry height="330" width="1000" x="960" y="100" as="geometry" />
        </mxCell>
        <mxCell id="n2b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" value="helper used everywhere below: void changeState(SystemState_t st) { current_state = st; isStateChange = true; }" vertex="1">
          <mxGeometry height="35" width="1000" x="960" y="445" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="main()&lt;br&gt;init();&lt;br&gt;while(1) {" vertex="1">
          <mxGeometry height="60" width="200" x="1360" y="500" as="geometry" />
        </mxCell>
        <mxCell id="n3b" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="isStateChange == true?" vertex="1">
          <mxGeometry height="90" width="280" x="1320" y="620" as="geometry" />
        </mxCell>
        <mxCell id="n3c" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="isStateChange = false;" vertex="1">
          <mxGeometry height="40" width="280" x="1320" y="760" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="switch(current_state)" vertex="1">
          <mxGeometry height="90" width="300" x="1310" y="840" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;align=left;spacing=6;" value="&lt;b&gt;case STATE_IDLE:&lt;/b&gt;&lt;br&gt;Set_Truth_RGB(OFF);&lt;br&gt;Set_Sensor_RGB(OFF);&lt;br&gt;Set_Fault(PIN_LOW);&lt;br&gt;Gate1_SetWidth(NEUTRAL);&lt;br&gt;Gate2_SetWidth(NEUTRAL);" vertex="1">
          <mxGeometry height="130" width="230" x="960" y="950" as="geometry" />
        </mxCell>
        <mxCell id="n6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;align=left;spacing=6;" value="&lt;b&gt;case STATE_ITEM_NEW:&lt;/b&gt;&lt;br&gt;Generate_Next_Item();&lt;br&gt;&lt;i&gt;(sets truth/sensor colour&lt;br&gt;+ lights Real/Sensed LEDs)&lt;/i&gt;&lt;br&gt;Set_Fault(PIN_LOW);&lt;br&gt;Gate1/2_SetWidth(NEUTRAL);" vertex="1">
          <mxGeometry height="130" width="260" x="1210" y="950" as="geometry" />
        </mxCell>
        <mxCell id="n7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;align=left;spacing=6;" value="&lt;b&gt;case STATE_STAGE1:&lt;/b&gt;&lt;br&gt;Set_Fault(PIN_LOW);&lt;br&gt;Gate1_SetWidth(&lt;br&gt;  Read_Sensor_RGB()==BLUE&lt;br&gt;  ? GATE_ANGLE_AC (1000)&lt;br&gt;  : GATE_ANGLE_C (2000)&lt;br&gt;);" vertex="1">
          <mxGeometry height="130" width="260" x="1490" y="950" as="geometry" />
        </mxCell>
        <mxCell id="n8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;align=left;spacing=6;" value="&lt;b&gt;case STATE_STAGE2:&lt;/b&gt;&lt;br&gt;Set_Fault(PIN_LOW);&lt;br&gt;switch(Read_Sensor_RGB()){&lt;br&gt;  GREEN → Gate2=AC (1000)&lt;br&gt;  RED   → Gate2=C (2000)&lt;br&gt;  default → Gate2=NEUTRAL&lt;br&gt;}" vertex="1">
          <mxGeometry height="130" width="260" x="1770" y="950" as="geometry" />
        </mxCell>
        <mxCell id="n9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10.5;align=left;spacing=6;" value="&lt;b&gt;case STATE_FAULT:&lt;/b&gt;&lt;br&gt;Set_Fault(PIN_HIGH);&lt;br&gt;Gate1_SetWidth(NEUTRAL);&lt;br&gt;Gate2_SetWidth(NEUTRAL);" vertex="1">
          <mxGeometry height="110" width="250" x="2060" y="950" as="geometry" />
        </mxCell>
        <mxCell id="n10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="} // end switch &amp; while(1) — back to top, loops forever" vertex="1">
          <mxGeometry height="50" width="340" x="1450" y="1280" as="geometry" />
        </mxCell>
