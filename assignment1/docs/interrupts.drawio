<mxfile host="app.diagrams.net">
  <diagram name="Sorting System Flowchart v4 (from actual code)" id="sortingFlow4">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;" value="System Power-Up" vertex="1">
          <mxGeometry height="50" width="260" x="440" y="90" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;align=left;verticalAlign=top;spacing=8;" value="&lt;div align=&quot;center&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b&gt;init()&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;1. Clock_Enable(GPIOA_BUS); Clock_Enable(GPIOB_BUS); Clock_Enable(GPIOC_BUS); Clock_Enable(TIM3_BUS);&lt;br&gt;2. GPIO_InitPinsSameMode(GPIOA, {2,10}, INPUT, PULL_DOWN); GPIO_InitPin(GPIOB, 5, INPUT, PULL_DOWN); &lt;i&gt;// New Item, Step Gate, E-Stop&lt;/i&gt;&lt;br&gt;3. GPIO_InitPinsSameMode(GPIOA, {9,0,1,4,3,11,8}, OUTPUT, PULL_DOWN); &lt;i&gt;// Fault LED + Real RGB + Sensed RGB&lt;/i&gt;&lt;br&gt;4. GPIO_InitPin(GPIOB,0,ALT,NONE); GPIO_InitPin(GPIOC,7,ALT,NONE); &lt;i&gt;// servo pins → alt-function mode&lt;/i&gt;&lt;br&gt;5. GPIO_ConnectPeripheral(GPIOB,0,1); GPIO_ConnectPeripheral(GPIOC,7,1); &lt;i&gt;// AF1 = TIM3&lt;/i&gt;&lt;br&gt;6. Timer_Init(TIM3, TIM3_IRQn, psc=47, arr=19999, ...); &lt;i&gt;// both gates share ONE timer, 50 Hz&lt;/i&gt;&lt;br&gt;7. PWM_Init(TIM3, CH2, PWM1, true); PWM_Init(TIM3, CH3, PWM1, true); &lt;i&gt;// CH2=Gate1(PC7), CH3=Gate2(PB0); starts counter&lt;/i&gt;&lt;br&gt;8. Gate1_SetWidth(GATE_ANGLE_NEUTRAL); Gate2_SetWidth(GATE_ANGLE_NEUTRAL); &lt;i&gt;// both = 1500&lt;/i&gt;&lt;br&gt;9. EXTI_Init(GPIOA,2,RISING,EXTI2_3_IRQn); EXTI_Init(GPIOA,10,RISING,EXTI4_15_IRQn); EXTI_Init(GPIOB,5,RISING,EXTI4_15_IRQn);&lt;br&gt;10. SysTick_Init();&lt;br&gt;&lt;font color=&quot;#0000ff&quot;&gt;typedef enum&lt;/font&gt; {STATE_IDLE, STATE_ITEM_NEW, STATE_STAGE1, STATE_STAGE2, STATE_FAULT} SystemState_t;&lt;br&gt;&lt;font color=&quot;#0000ff&quot;&gt;volatile&lt;/font&gt; SystemState_t current_state = STATE_IDLE; &lt;font color=&quot;#0000ff&quot;&gt;volatile bool&lt;/font&gt; isStateChange = false;&lt;/font&gt;" vertex="1">
          <mxGeometry height="330" width="1000" x="70" y="220" as="geometry" />
        </mxCell>
        <mxCell id="n11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" value="ISR 1 (New Item): EXTI2_3_IRQHandler" vertex="1">
          <mxGeometry height="40" width="400" x="60" y="650" as="geometry" />
        </mxCell>
        <mxCell id="n12" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="EXTI-&gt;RPR1 &amp; (1&lt;&lt;2)?" vertex="1">
          <mxGeometry height="90" width="300" x="110" y="720" as="geometry" />
        </mxCell>
        <mxCell id="n13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="Exit ISR" vertex="1">
          <mxGeometry height="40" width="140" x="440" y="800" as="geometry" />
        </mxCell>
        <mxCell id="n14" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="current_state ==&lt;br&gt;STATE_IDLE?" vertex="1">
          <mxGeometry height="90" width="300" x="110" y="940" as="geometry" />
        </mxCell>
        <mxCell id="n15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="changeState(STATE_ITEM_NEW);" vertex="1">
          <mxGeometry height="50" width="280" x="120" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="n17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="Exit ISR" vertex="1">
