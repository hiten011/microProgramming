        <mxCell id="n19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;align=center;" value="ISR 2 (Step Gate &amp; E-Stop): EXTI4_15_IRQHandler&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#b85450&quot;&gt;shared vector — Step Gate (bit10) checked first, then E-Stop (bit5), independently&lt;/font&gt;" vertex="1">
          <mxGeometry height="50" width="700" x="600" y="650" as="geometry" />
